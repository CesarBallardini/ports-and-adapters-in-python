# Coverage configuration -- deliberately its own file rather than a
# [tool.coverage.*] table in pyproject.toml, so it sits alongside the other
# quality-gate configs (ruff.toml, bandit.yaml, pyrightconfig.json, pyrefly.toml)
# and can be passed explicitly with --cov-config from any working directory.
#
# fail_under is a hard gate, not a report: `pytest --cov` exits non-zero below
# it, so a coverage drop fails CI the same way a lint or type error does.
#
# The floor was 70 while the hexagon was being built outward. The contract suite
# (ADR-0014) now asserts the repository ports against the in-memory adapter and
# the clock adapters are exercised, so measured coverage is ~93% and the floor
# moves to 90.
#
# The remaining gap is deliberate and is mostly one thing: the port modules that
# nothing imports yet sit at 0%, because a `Protocol` body never executes until
# an adapter implements it. Those recover on their own in Phase B. Do not buy
# them with an import statement in a test -- it would move the number without
# moving the risk. The rest is the copied domain, whose tests are copied too and
# cannot be added to (ADR-0002).
#
# Raise it again as each phase closes, but keep a little slack: a floor set at
# exactly today's number fails the moment a new adapter lands ahead of its
# contract tests.

[report]
fail_under = 90
show_missing = true
precision = 0
