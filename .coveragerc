# Coverage configuration -- deliberately its own file rather than a
# [tool.coverage.*] table in pyproject.toml, so it sits alongside the other
# quality-gate configs (ruff.toml, bandit.yaml, pyrightconfig.json, pyrefly.toml)
# and can be passed explicitly with --cov-config from any working directory.
#
# fail_under is a hard gate, not a report: `pytest --cov` exits non-zero below
# it, so a coverage drop fails CI the same way a lint or type error does.
#
# The floor was 70 while the hexagon was being built outward, then 90 once the
# contract suite (ADR-0014) and the clock adapters landed. The CLI closed Phase
# C's first adapter with every one of its modules at 100%, so measured coverage
# is ~97% and the floor moves to 95.
#
# The slack is deliberate and is not padding: a floor set at exactly today's
# number fails the moment a new adapter lands ahead of its contract tests, which
# punishes the order this repository builds in.
#
# The remaining gap is three things, all measured rather than guessed. The port
# modules nothing implements yet sit at 0%, because a `Protocol` body never
# executes until an adapter satisfies it -- `notifications` is now the whole
# list, `identity` having recovered when the web adapter gave it two adapters
# and a contract suite (ADR-0022). The bulk is the copied domain, whose tests are
# copied too and cannot be added to (ADR-0002).
#
# The third is the entry points, which are covered by the e2e tier in
# subprocesses coverage does not measure: `src/academy/__main__.py`, and the
# `create_app` body in `src/academy/config/__init__.py`. Both are the
# best-tested lines in the repository and will always look like the worst --
# `tests/e2e/test_web_process.py` starts a real uvicorn against the second one.
# Do not "fix" either by calling it from an in-process test: what the e2e tier
# proves about them is precisely that they work in a process nobody set up.
#
# Do not buy any of them with a test written for the number. An import statement
# that lights up a port module moves the figure without moving the risk.
#
# Raise it again as each phase closes.

[report]
fail_under = 95
show_missing = true
precision = 0
